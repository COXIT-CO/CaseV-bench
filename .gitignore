# ── Secrets ──────────────────────────────────────────────────────────────
.env
!.env.example

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Client architectural drawings sometimes dropped in for local testing —
# these often carry "PROPERTY OF ..." / "FOR OFFICIAL USE ONLY" notices.
# Not present in the repo right now, but keeping this so a test PDF never
# accidentally gets committed later. Delete this line if that's not a risk
# for you.
*.pdf
drafts/

# ── Run history ──────────────────────────────────────────────────────────
# Every run writes HISTORY_DIR/<run_id>/ with meta.json plus a full-DPI PNG
# of every page it sent. These are local run artifacts, they grow without
# bound (high-DPI sheets are megabytes each), and the images are renders of
# the same client drawings *.pdf above exists to keep out of the repo.
history/

# ── OS / editor ──────────────────────────────────────────────────────────
.DS_Store
.idea/

# ── Docker ───────────────────────────────────────────────────────────────
*.log