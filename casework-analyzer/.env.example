# Copy this file to .env and fill in your key. Never commit the real .env file.
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: sent as attribution headers on OpenRouter requests
# (https://openrouter.ai/docs#requests). Not required for the app to work.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Casework Drawing Analyzer
